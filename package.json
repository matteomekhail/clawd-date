{
  "name": "clawd-date",
  "version": "0.0.1",
  "private": true,
  "description": "Matchmaking for devs, powered by your Claude Code history",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "turbo run clean && rm -rf node_modules",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "cli": "node scripts/cli.mjs",
    "publish:skill": "node scripts/publish-skill.mjs",
    "install:dev": "node scripts/install-dev.mjs",
    "uninstall:dev": "node scripts/install-dev.mjs --remove"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "convex": "^1.17.0",
    "convex-test": "^0.0.50",
    "ink-testing-library": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10"
    }
  }
}
