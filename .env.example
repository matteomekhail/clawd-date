# ─── Web (apps/web) ───────────────────────────────────────────────
# WebSocket/HTTPS deployment URL printed by `npx convex dev`
# (looks like https://<deployment>.convex.cloud)
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Convex backend ───────────────────────────────────────────────
# Backend secrets (e.g. ANTHROPIC_API_KEY, GITHUB_CLIENT_SECRET) are NOT
# stored here. Set them with `npx convex env set <KEY> <VALUE>` so they
# live in the Convex deployment, not the repo.

# ─── Skill (apps/skill) ───────────────────────────────────────────
# Public Convex HTTP actions URL — note the .convex.site domain (vs
# .convex.cloud above). Printed by `npx convex dev`.
CLAWD_API_URL=
