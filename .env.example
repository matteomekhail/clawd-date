# ─── Web (apps/web) ───────────────────────────────────────────────
# Web URLs are per-mode and committed:
#   apps/web/.env.development → dev Convex
#   apps/web/.env.production  → prod Convex
# `next dev` picks development; `next build` (and Vercel prod) pick production.
# This file is for backend tooling + the CLI dev wrapper, not the web app.

# ─── Convex backend ───────────────────────────────────────────────
# Deployment used by `npx convex dev` (push backend code to dev).
# `npx convex deploy` pushes to prod — keep prod creds out of this file.
CONVEX_DEPLOYMENT=

# Dev Convex URLs printed by `npx convex dev` on first run.
CONVEX_URL=
CONVEX_SITE_URL=

# Backend secrets (e.g. ANTHROPIC_API_KEY, GITHUB_CLIENT_SECRET) are NOT
# stored here. Set them with `npx convex env set <KEY> <VALUE>` so they
# live in the Convex deployment, not the repo.

# ─── Skill / CLI ──────────────────────────────────────────────────
# CLI build bakes these URLs into the binaries via esbuild `define`.
#   CLAWD_DEV_API_URL  → embedded in `clawd-date-dev` (local-only binary)
#   CLAWD_PROD_API_URL → embedded in `clawd-date` (the npm-published binary)
# `pnpm publish:skill` aborts if CLAWD_PROD_API_URL is missing, so a
# misconfigured machine cannot ship a broken/dev-pointed package.
CLAWD_DEV_API_URL=
CLAWD_PROD_API_URL=

# scripts/cli.mjs (the in-repo `pnpm cli` wrapper) reads CONVEX_SITE_URL
# above and runs the CLI against dev with a repo-local config
# (.clawd-date-local/config.json), so a globally-installed `clawd-date`
# is not affected.
#
# Optional overrides:
#   CLAWD_MATCH_API_URL=https://...convex.site
#   CLAWD_DATE_CONFIG_PATH=/abs/path/config.json
